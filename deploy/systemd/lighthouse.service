# lighthouse — development chain server (systemd user unit)
#
# Runs `lighthouse serve`: the API and web UI of the development chain, one server per
# machine, serving every repository from one SQLite database.
#
# Why loopback: `serve` binds 127.0.0.1:8127 by default and has no authentication. Only the
# host itself (and the tailnet, through deploy/tailscale-serve.sh) may reach it.
#
# Why StateDirectory: under ProtectHome=read-only `serve` cannot create its state directory,
# and a ReadWritePaths= to a directory that does not exist fails the first start with
# 226/NAMESPACE. StateDirectory= makes systemd create the directory (mode 0700) before the
# start and keeps it writable inside the hardening. %S is the user manager's state directory
# ($XDG_STATE_HOME, else ~/.local/state), the same path StateDirectory= creates.
#
# Why EnvironmentFile: the forge token (GH_TOKEN) and repository (LIGHTHOUSE_FORGE_REPO) live
# in ~/.config/lighthouse/forge.env, outside the unit, because the token is a secret: keep the
# file mode 0600. The leading dash lets the server start without the file; the forge
# endpoints then answer 503 until it exists.
#
# Why ReadWritePaths for .codex: `codex app-server` keeps its sqlite state in CODEX_HOME and
# exits at once when that directory is read-only ("failed to initialize sqlite state runtime").
# The ReadWritePaths= line makes both Codex homes writable inside the hardening. The `-` prefix
# ignores a directory that does not exist; without it a machine lacking one of the homes would
# fail the first start with 226/NAMESPACE.
#
# Install (details in docs/install.md):
#   go install github.com/CorneeldH/lighthouse/cmd/lighthouse@main
#   mkdir -p ~/.config/systemd/user
#   cp deploy/systemd/lighthouse.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now lighthouse.service
#   loginctl enable-linger "$USER"
#
# %h/go/bin is where `go install` puts the binary; edit ExecStart if yours lives elsewhere.

[Unit]
Description=lighthouse — development chain server

[Service]
Type=exec
EnvironmentFile=-%h/.config/lighthouse/forge.env
ExecStart=%h/go/bin/lighthouse serve --db %S/lighthouse/lighthouse.db
StateDirectory=lighthouse
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.codex -%h/.codex-specreview
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lighthouse

[Install]
WantedBy=default.target
