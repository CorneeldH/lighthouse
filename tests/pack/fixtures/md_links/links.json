{
  "strip_code": [
    {
      "name": "both fence styles and inline code",
      "text": "a\n\u0060\u0060\u0060\n[x](f1.md)\n\u0060\u0060\u0060\n~~~markdown\n[y](f2.md)\n~~~\n`[z](f3.md)` [w](ok.md)\n",
      "expect": "a\n [w](ok.md)"
    },
    {
      "name": "fence marker inside a line",
      "text": "s = \"\u0060\u0060\u0060\"\n[x](echt.md)\n",
      "expect": "s = \"`\"\n[x](echt.md)"
    },
    {
      "name": "indented fence",
      "text": "  \u0060\u0060\u0060\n[x](f.md)\n  \u0060\u0060\u0060\n[y](ok.md)\n",
      "expect": "[y](ok.md)"
    },
    {
      "name": "unclosed fence swallows the rest",
      "text": "[a](ok.md)\n\u0060\u0060\u0060\n[b](weg.md)\n",
      "expect": "[a](ok.md)"
    },
    {
      "name": "crlf line endings",
      "text": "[a](b.md)\r\n`[c](d.md)` [e](f.md)\r\n",
      "expect": "[a](b.md)\n [e](f.md)"
    },
    {
      "name": "no trailing newline",
      "text": "[a](b.md)",
      "expect": "[a](b.md)"
    },
    {
      "name": "empty",
      "text": "",
      "expect": ""
    },
    {
      "name": "nbsp before fence",
      "text": "\u00a0\u0060\u0060\u0060\n[x](f.md)\n\u0060\u0060\u0060\n[y](ok.md)\n",
      "expect": "[y](ok.md)"
    },
    {
      "name": "line separator splits a line",
      "text": "[a](b.md)\u2028[c](d.md)",
      "expect": "[a](b.md)\n[c](d.md)"
    },
    {
      "name": "form feed splits a line",
      "text": "x\f~~~\n[a](b.md)\n~~~\n",
      "expect": "x"
    },
    {
      "name": "inline code does not span lines",
      "text": "`[a](b.md)\n[c](d.md)`",
      "expect": "`[a](b.md)\n[c](d.md)`"
    }
  ],
