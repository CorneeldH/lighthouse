  "absolute": [
    {
      "name": "new link forms",
      "text": "[a](</home/x y.md>) [b](/abs.md 'titel') [c](/p.md (titel))",
      "expect": [
        "/home/x y.md",
        "/abs.md",
        "/p.md"
      ]
    },
    {
      "name": "outside code only",
      "text": "[a](/home/x.md)\n\u0060\u0060\u0060\n[b](/home/y.md)\n\u0060\u0060\u0060\n",
      "expect": [
        "/home/x.md"
      ]
    },
    {
      "name": "relative links are not absolute",
      "text": "[a](b.md) [c](#kop) [d](https://x.nl)",
      "expect": []
