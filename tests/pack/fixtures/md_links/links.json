  "problems": [
    {
      "name": "angle link with spaces",
      "files": {
        "a b.md": "x",
        "doc.md": "[ok](<a b.md>) [weg](<c d.md>) [t](weg.md 'titel')\n"
      },
      "dirs": [],
      "md": "doc.md",
      "expect": [
        [
          "dead",
          "c d.md"
        ],
        [
          "dead",
          "weg.md"
        ]
      ]
    },
    {
      "name": "dead absolute and outside root",
      "files": {
        "docs/er.md": "x",
