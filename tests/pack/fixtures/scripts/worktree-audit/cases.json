 {
  "name": "a closing PR that is merged counts as a merged head of the issue",
  "argv": [
   "--issue",
   "9"
  ],
  "config": "[forge]\nkind = \"github\"\nrepo = \"o/r\"\n",
  "env": {},
  "setup": [
   {
    "repo": ".",
    "branch": "main"
   },
   {
    "worktree": ".claude/worktrees/fix-y",
    "of": ".",
    "branch": "fix-y"
   }
  ],
  "forge_calls": [
   {
    "method": "GET",
    "path": "/repos/o/r/pulls?state=all&per_page=100",
    "status": 200,
    "body": [
     {
      "number": 12,
      "state": "closed",
      "merged_at": "2099-01-01T00:00:00Z",
      "head": {
       "ref": "fix-y"
      }
     }
    ]
   },
   {
    "method": "POST",
    "path": "/graphql",
    "status": 200,
    "body": {
     "data": {
      "repository": {
       "issue": {
        "closedByPullRequestsReferences": {
         "pageInfo": {
          "hasNextPage": false
         },
         "nodes": [
          {
           "number": 12,
           "headRefName": "fix-y",
           "merged": true,
           "isCrossRepository": false,
           "repository": {
            "nameWithOwner": "o/r"
           },
           "body": ""
          }
         ]
        },
        "timelineItems": {
         "pageInfo": {
          "hasNextPage": false
         },
         "nodes": []
        }
       }
      }
     }
    }
   }
