[
  {
    "name": "test_last_blocker_closed_releases_with_comments",
    "argv": [
      "--issue",
      "1"
    ],
    "config": "[forge]\nrepo = \"Owner/repo\"\n",
    "env": {},
    "calls": [
      {
        "argv": [
          "gh",
          "api",
          "repos/{owner}/{repo}/issues/1"
        ],
        "stdin": null,
        "stdout": "{\"number\": 1, \"state\": \"closed\", \"state_reason\": \"completed\", \"labels\": []}",
        "stderr": "",
        "code": 0
      },
      {
        "argv": [
          "gh",
          "api",
          "repos/{owner}/{repo}/issues/1/dependencies/blocking?per_page=100"
        ],
        "stdin": null,
        "stdout": "[{\"number\": 2, \"state\": \"open\", \"state_reason\": null, \"labels\": [{\"name\": \"2-area:x\"}, {\"name\": \"blocked-issue\"}]}]",
        "stderr": "",
        "code": 0
      },
      {
        "argv": [
          "gh",
          "api",
          "repos/{owner}/{repo}/issues/2/dependencies/blocked_by?per_page=100"
        ],
        "stdin": null,
        "stdout": "[{\"number\": 1, \"state\": \"closed\", \"state_reason\": \"completed\", \"labels\": []}]",
        "stderr": "",
        "code": 0
      },
      {
        "argv": [
          "gh",
          "api",
          "-X",
          "POST",
          "repos/{owner}/{repo}/issues/1/comments",
          "-f",
          "body=Released lane after this close:\n\n- #2 is released: `blocked-issue` comes off"
        ],
        "stdin": null,
        "stdout": "{}",
        "stderr": "",
        "code": 0
      },
      {
        "argv": [
          "gh",
          "api",
          "-X",
          "POST",
          "repos/{owner}/{repo}/issues/2/comments",
          "-f",
          "body=Released: the last open blocker #1 is closed; the release lane removes `blocked-issue`."
        ],
        "stdin": null,
        "stdout": "{}",
        "stderr": "",
        "code": 0
      },
      {
        "argv": [
          "gh",
          "api",
          "-X",
          "DELETE",
          "repos/{owner}/{repo}/issues/2/labels/blocked-issue"
        ],
        "stdin": null,
        "stdout": "{}",
        "stderr": "",
        "code": 0
      }
    ],
    "expect": {
      "stdout": "## Release lane for #1\n\n- #2: released, `blocked-issue` comes off\n",
      "stderr": "",
      "code": 0
    }
  },
