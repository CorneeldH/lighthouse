 {
  "name": "project-filter-drops-a-foreign-repo-and-flags-a-broken-one",
  "kind": "project_filter",
  "setup": [
   {
    "repo": "main",
    "branch": "main"
   },
   {
    "worktree": "main/wt",
    "of": "main",
    "branch": "wt-branch"
   },
   {
    "repo": "foreign",
    "branch": "main"
   },
   {
    "repo": "broken",
    "branch": "main"
   },
   {
    "overwrite": "broken/.git/HEAD",
    "text": "garbage\n"
   }
  ],
  "roots": [
   "{real:main}",
   "{real:main/wt}",
   "{real:foreign}",
   "{real:broken}"
  ],
  "project": "{root}/main",
  "expect": {
   "kept": [
    "{real:main}",
    "{real:main/wt}"
   ],
   "error_prefixes": [
    "COULD NOT CHECK: {real:broken} ("
   ]
  }
 },
 {
  "name": "project-filter-keeps-a-forge-worktree-of-the-same-repo",
  "kind": "project_filter",
  "setup": [
   {
    "repo": "main",
    "branch": "main"
   },
   {
    "origin": "main",
    "url": "https://github.com/Acme/widgets.git"
   },
   {
    "repo": "clone",
    "branch": "main"
   },
   {
    "origin": "clone",
    "url": "https://github.com/Acme/widgets.git"
   },
   {
    "worktree": "clone/work",
    "of": "clone",
    "branch": "work"
   }
  ],
  "roots": [
   "{real:clone/work}"
  ],
  "project": "{root}/main",
  "expect": {
   "kept": [
    "{real:clone/work}"
   ],
   "error_prefixes": []
  }
 },
 {
  "name": "project-filter-raises-when-the-project-dir-is-broken",
  "kind": "project_filter",
  "setup": [
   {
    "repo": "broken",
    "branch": "main"
   },
   {
    "overwrite": "broken/.git/HEAD",
    "text": "garbage\n"
   }
  ],
  "roots": [],
  "project": "{root}/broken",
  "expect": "raises"
 }
