 {
  "name": "derive-roots-covers-cwd-cd-git-dash-c-and-literal-paths",
  "kind": "derive_roots",
  "setup": [
   {
    "repo": "a",
    "branch": "main"
   },
   {
    "repo": "a/b",
    "branch": "main"
   },
   {
    "repo": "a/c",
    "branch": "main"
   },
   {
    "repo": "a/d",
    "branch": "main"
   },
   {
    "repo": "e",
    "branch": "main"
   }
  ],
  "env": {
   "HOME": "{root}"
  },
  "command": "(cd b && true); git -C c status; cat > d/x.sh <<'EOF'\necho x\nEOF\ncat > ~/e/z.sh <<'EOF'\necho x\nEOF",
  "cwd": "{root}/a",
  "expect": [
   "{real:a/b}",
   "{real:a/c}",
   "{real:a/d}",
   "{real:a}",
   "{real:e}"
  ]
 },
 {
  "name": "derive-roots-finds-a-relative-gitignored-nested-worktree",
  "kind": "derive_roots",
  "setup": [
   {
    "repo": "main",
    "branch": "main"
   },
   {
    "file": "main/.gitignore",
    "text": "wt/\n"
   },
   {
    "worktree": "main/wt",
    "of": "main",
    "branch": "wt-branch"
   }
  ],
  "env": {},
  "command": "cat > wt/x.sh <<'EOF'\necho x\nEOF",
  "cwd": "{root}/main",
  "expect": [
   "{real:main/wt}",
   "{real:main}"
  ]
 },
 {
  "name": "derive-roots-on-an-open-quote-still-finds-an-absolute-path",
