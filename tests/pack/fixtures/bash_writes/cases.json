[
 {
  "name": "porcelain-rename-source-is-removed",
  "kind": "porcelain",
  "input": " M a.py\u0000R  new.sh\u0000old.sh\u0000C  cp.sh\u0000src.sh\u0000 D gone.sh\u0000?? sp ace.sh\u0000",
  "expect": {
   "changed": [
    "a.py",
    "cp.sh",
    "new.sh",
    "sp ace.sh"
   ],
   "deleted": [
    "gone.sh",
    "old.sh"
   ]
  }
 },
 {
  "name": "porcelain-keeps-newlines-and-non-ascii",
  "kind": "porcelain",
  "input": "?? a\nb.sh\u0000?? ü.sh\u0000",
  "expect": {
   "changed": [
    "a\nb.sh",
    "ü.sh"
   ],
   "deleted": []
  }
 },
 {
  "name": "diff-tree-combined-status-with-d-is-deleted",
  "kind": "diff_tree",
  "input": "MM\u0000c.py\u0000DM\u0000x.sh\u0000A\u0000n.md\u0000",
  "expect": {
   "changed": [
    "c.py",
    "n.md"
   ],
   "deleted": [
    "x.sh"
   ]
  }
 },
