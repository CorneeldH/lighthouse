{
  "description": "round_limit with an 'accept' MAJOR in round 3: exit 4, names accept-open.",
  "steps": [
    {
      "op": "run",
      "args": [
        "start",
        "${PLAN}"
      ],
      "bind": "a",
      "expect": {}
    },
    {
      "op": "round",
      "attempt": "a",
      "n": 1,
      "severities": [
        "MAJOR"
      ]
    },
    {
      "op": "file",
      "path": "${a}/round-1.decisions.json",
      "json": [
        {
          "finding_id": "r1-f1",
          "decision": "accept",
          "reason": "x"
        }
      ]
    },
    {
      "op": "round",
      "attempt": "a",
      "n": 2,
      "severities": [
        "MAJOR"
      ],
      "verified": []
    },
    {
      "op": "file",
      "path": "${a}/round-2.decisions.json",
      "json": [
        {
          "finding_id": "r2-f1",
          "decision": "accept",
          "reason": "x"
        }
      ]
    },
    {
      "op": "round",
      "attempt": "a",
      "n": 3,
      "severities": [
        "MAJOR"
      ],
      "verified": []
    },
    {
      "op": "file",
      "path": "${a}/round-3.decisions.json",
      "json": [
        {
          "finding_id": "r3-f1",
          "decision": "accept",
          "reason": "x"
        }
      ]
    },
    {
      "op": "run",
      "args": [
        "write",
        "${a}",
        "--outcome",
        "round_limit",
        "--review-mode",
        "codex",
        "--spec",
        "${SPEC}"
      ],
      "expect": {
        "code": 4,
        "stderr_contains": [
          "r3-f1",
          "accept-open",
          "accept-open <ATTEMPT> --doc <DOC>"
        ]
      }
    }
  ]
}
