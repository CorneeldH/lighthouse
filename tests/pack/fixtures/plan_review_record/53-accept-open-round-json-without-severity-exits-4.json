{
  "description": "A finding without severity: exit 4 with ACCEPT-OPEN FAILED, nothing written.",
  "steps": [
    {
      "op": "run",
      "args": [
        "start",
        "${PLAN}"
      ],
      "bind": "a",
      "expect": {}
    },
    {
      "op": "file",
      "path": "${tmp}/plan.md",
      "text": "# Plan\n\nTekst.\n"
    },
    {
      "op": "round_raw",
      "attempt": "a",
      "n": 1,
      "findings": [
        {
          "cat": "code",
          "plan_section": "Taak 1",
          "problem": "p"
        }
      ]
    },
    {
      "op": "run",
      "args": [
        "accept-open",
        "${a}",
        "--doc",
        "${tmp}/plan.md"
      ],
      "expect": {
        "code": 4,
        "stderr_starts_with": "ACCEPT-OPEN FAILED:",
        "stderr_not_contains": [
          "Traceback"
        ],
        "stdout_equals": ""
      }
    },
    {
      "op": "expect_file",
      "path": "${a}/round-1.decisions.json",
      "exists": false
    },
    {
      "op": "expect_file",
      "path": "${tmp}/plan.md",
      "text": "# Plan\n\nTekst.\n"
    }
  ]
}
