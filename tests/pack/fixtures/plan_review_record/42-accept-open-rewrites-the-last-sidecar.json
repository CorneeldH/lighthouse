{
  "description": "accept-open turns the open MAJOR into accepted_open, keeps reject and minor, appends the block.",
  "steps": [
    {
      "op": "run",
      "args": [
        "start",
        "${PLAN}"
      ],
      "bind": "a",
      "expect": {}
    },
    {
      "op": "file",
      "path": "${tmp}/plan.md",
      "text": "# Plan\n\nTekst.\n"
    },
    {
      "op": "round",
      "attempt": "a",
      "n": 1,
      "severities": [
        "MAJOR"
      ]
    },
    {
      "op": "round",
      "attempt": "a",
      "n": 2,
      "severities": [
        "MAJOR"
      ],
      "verified": []
    },
    {
      "op": "round",
      "attempt": "a",
      "n": 3,
      "severities": [
        "MAJOR",
        "BLOCKER",
        "MINOR"
      ],
      "verified": []
    },
    {
      "op": "file",
      "path": "${a}/round-3.decisions.json",
      "json": [
        {
          "finding_id": "r3-f1",
          "decision": "accept",
          "reason": "fix in Taak 2"
        },
        {
          "finding_id": "r3-f2",
          "decision": "reject",
          "reason": "klopt niet"
        },
        {
          "finding_id": "r3-f3",
          "decision": "minor_no",
          "reason": "x"
        }
      ]
    },
    {
      "op": "run",
      "args": [
        "accept-open",
        "${a}",
        "--doc",
        "${tmp}/plan.md"
      ],
      "expect": {
        "stdout_starts_with": "## Open na review\n",
        "stdout_contains": [
          "- **r3-f1** (MAJOR, Taak 1): p"
        ],
        "stdout_not_contains": [
          "r3-f2"
        ]
      }
    },
    {
      "op": "expect_file",
      "path": "${a}/round-3.decisions.json",
      "json": [
        {
          "finding_id": "r3-f1",
          "decision": "accepted_open",
          "reason": "round_limit; was accept: fix in Taak 2"
        },
        {
          "finding_id": "r3-f2",
          "decision": "reject",
          "reason": "klopt niet"
        },
        {
          "finding_id": "r3-f3",
          "decision": "minor_no",
          "reason": "x"
        }
      ]
    },
    {
      "op": "expect_file",
      "path": "${tmp}/plan.md",
      "text": "# Plan\n\nTekst.\n\n${stdout}"
    }
  ]
}
