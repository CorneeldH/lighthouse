{
  "description": "A finding without a section prints '?'.",
  "steps": [
    {
      "op": "run",
      "args": [
        "start",
        "${PLAN}"
      ],
      "bind": "a",
      "expect": {}
    },
    {
      "op": "file",
      "path": "${tmp}/plan.md",
      "text": "# Plan\n\nTekst.\n"
    },
    {
      "op": "round_raw",
      "attempt": "a",
      "n": 1,
      "findings": [
        {
          "severity": "BLOCKER",
          "cat": "x",
          "problem": "p"
        }
      ]
    },
    {
      "op": "run",
      "args": [
        "accept-open",
        "${a}",
        "--doc",
        "${tmp}/plan.md"
      ],
      "expect": {
        "stdout_contains": [
          "- **r1-f1** (BLOCKER, ?): p"
        ]
      }
    }
  ]
}
