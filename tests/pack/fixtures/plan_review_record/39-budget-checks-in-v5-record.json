      "path": "${a}/round-1.codex.json.budget.json",
      "json": {
        "decision": "fallback",
        "reason": "5u 92% ≥ 90%",
        "window": "codex-5u",
        "reset_at": "2026-10-03T19:06:00Z",
        "session_pct": 92,
        "week_pct": 41,
        "source": "app-server",
        "thresholds": {
          "session": 90,
          "week": 95
        }
      }
    },
