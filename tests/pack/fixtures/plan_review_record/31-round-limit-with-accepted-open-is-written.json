{
  "description": "round_limit with accepted_open: written, the open point recorded.",
  "steps": [
    {
      "op": "run",
      "args": [
        "start",
        "${PLAN}"
      ],
      "bind": "a",
      "expect": {}
    },
    {
      "op": "round",
      "attempt": "a",
      "n": 1,
      "severities": [
        "MAJOR"
      ]
    },
    {
      "op": "file",
      "path": "${a}/round-1.decisions.json",
      "json": [
        {
          "finding_id": "r1-f1",
          "decision": "accept",
          "reason": "x"
        }
      ]
    },
    {
      "op": "round",
      "attempt": "a",
      "n": 2,
      "severities": [
        "MAJOR"
      ],
      "verified": []
    },
    {
      "op": "file",
      "path": "${a}/round-2.decisions.json",
      "json": [
        {
          "finding_id": "r2-f1",
          "decision": "accept",
          "reason": "x"
        }
      ]
    },
    {
      "op": "round",
      "attempt": "a",
      "n": 3,
      "severities": [
        "MAJOR"
      ],
      "verified": []
    },
    {
      "op": "file",
      "path": "${a}/round-3.decisions.json",
      "json": [
        {
          "finding_id": "r3-f1",
          "decision": "accepted_open",
          "reason": "x"
        }
      ]
    },
    {
      "op": "run",
      "args": [
        "write",
        "${a}",
        "--outcome",
        "round_limit",
        "--review-mode",
        "codex",
        "--spec",
        "${SPEC}"
      ],
      "expect": {
        "record": {
          "outcome": "round_limit",
          "last_round_open": [
            {
              "finding_id": "r3-f1",
              "severity": "MAJOR",
              "decision": "accepted_open"
            }
          ]
        }
      }
    }
  ]
}
