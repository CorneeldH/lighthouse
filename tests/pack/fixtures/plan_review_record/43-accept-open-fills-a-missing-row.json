{
  "description": "An empty sidecar gets a row for the open point.",
  "steps": [
    {
      "op": "run",
      "args": [
        "start",
        "${PLAN}"
      ],
      "bind": "a",
      "expect": {}
    },
    {
      "op": "file",
      "path": "${tmp}/plan.md",
      "text": "# Plan\n\nTekst.\n"
    },
    {
      "op": "round",
      "attempt": "a",
      "n": 3,
      "severities": [
        "MAJOR"
      ]
    },
    {
      "op": "file",
      "path": "${a}/round-3.decisions.json",
      "json": []
    },
    {
      "op": "run",
      "args": [
        "accept-open",
        "${a}",
        "--doc",
        "${tmp}/plan.md"
      ],
      "expect": {}
    },
    {
      "op": "expect_file",
      "path": "${a}/round-3.decisions.json",
      "json": [
        {
          "finding_id": "r3-f1",
          "decision": "accepted_open",
          "reason": "round_limit; without an earlier decision"
        }
      ]
    }
  ]
}
