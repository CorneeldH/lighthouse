{
  "description": "The same finding_id twice in a sidecar: exit 4.",
  "steps": [
    {
      "op": "run",
      "args": [
        "start",
        "${PLAN}"
      ],
      "bind": "a",
      "expect": {}
    },
    {
      "op": "round",
      "attempt": "a",
      "n": 1,
      "severities": [
        "MAJOR"
      ]
    },
    {
      "op": "file",
      "path": "${a}/round-1.decisions.json",
      "json": [
        {
          "finding_id": "r1-f1",
          "decision": "accept",
          "reason": "x"
        },
        {
          "finding_id": "r1-f1",
          "decision": "reject",
          "reason": "y"
        }
      ]
    },
    {
      "op": "run",
      "args": [
        "write",
        "${a}",
        "--outcome",
        "aborted",
        "--review-mode",
        "codex",
        "--spec",
        "${SPEC}"
      ],
      "expect": {
        "code": 4,
        "stderr_contains": [
          "occurs twice"
        ]
      }
    }
  ]
}
