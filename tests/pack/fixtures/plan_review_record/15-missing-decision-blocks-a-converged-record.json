{
  "description": "No sidecar for the last round: a converged record would store decision null; exit 4.",
  "steps": [
    {
      "op": "run",
      "args": [
        "start",
        "${PLAN}"
      ],
      "bind": "a",
      "expect": {}
    },
    {
      "op": "round",
      "attempt": "a",
      "n": 1,
      "severities": [
        "MAJOR"
      ]
    },
    {
      "op": "run",
      "args": [
        "write",
        "${a}",
        "--outcome",
        "converged",
        "--review-mode",
        "codex",
        "--spec",
        "${SPEC}"
      ],
      "expect": {
        "code": 4,
        "stderr_contains": [
          "no decision for r1-f1"
        ]
      }
    }
  ]
}
