{
  "description": "Sources need --shadow-model, and --shadow-model needs sources: both exit 4.",
  "steps": [
    {
      "op": "run",
      "args": [
        "start",
        "${PLAN}"
      ],
      "bind": "a",
      "expect": {}
    },
    {
      "op": "round",
      "attempt": "a",
      "n": 1,
      "severities": [
        "MAJOR"
      ]
    },
    {
      "op": "file",
      "path": "${a}/round-1.decisions.json",
      "json": [
        {
          "finding_id": "r1-f1",
          "decision": "accept",
          "reason": "x"
        }
      ]
    },
    {
      "op": "file",
      "path": "${a}/round-1.sources.json",
      "json": [
        {
          "finding_id": "r1-f1",
          "source": "codex",
          "blind_ids": [
            "A"
          ],
          "severity_by_source": {
            "codex": "MAJOR"
          }
        }
      ]
    },
    {
      "op": "run",
      "args": [
        "write",
        "${a}",
        "--outcome",
        "aborted",
        "--review-mode",
        "codex",
        "--spec",
        "${SPEC}"
      ],
      "expect": {
        "code": 4,
        "stderr_contains": [
          "--shadow-model"
        ]
      }
    },
    {
      "op": "run",
      "args": [
        "start",
        "${PLAN}"
      ],
      "bind": "b",
      "expect": {}
    },
    {
      "op": "round",
      "attempt": "b",
      "n": 1,
      "severities": []
    },
    {
      "op": "run",
      "args": [
        "write",
        "${b}",
        "--outcome",
        "converged",
        "--review-mode",
        "codex",
        "--spec",
        "${SPEC}",
        "--shadow-model",
        "claude-opus-5-5"
      ],
      "expect": {
        "code": 4,
        "stderr_contains": [
          "--shadow-model"
        ]
      }
    }
  ]
}
