 {
  "name": "walk-yields-dir-in-effect",
  "setup": [
   {
    "dir": "a"
   }
  ],
  "env": {},
  "kind": "walk",
  "command": "cd {root}/a && touch x; (cd /; ls); pwd",
  "cwd": "",
  "expect": [
   [
    "cd",
    "{root}"
   ],
   [
    "touch",
    "{root}/a"
   ],
   [
    "cd",
    "{root}/a"
   ],
   [
    "ls",
    "/"
   ],
   [
    "pwd",
    "{root}/a"
   ]
  ]
 },
