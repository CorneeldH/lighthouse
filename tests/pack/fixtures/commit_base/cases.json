[
  {"name": "record-one-repo", "kind": "record", "setup": [{"repo": "repo", "branch": "main"}], "roots": ["{root}/repo"], "expect": {"heads": {"{root}/repo": "{rev:repo:HEAD}"}}},
  {"name": "record-unborn-repo", "kind": "record", "setup": [{"unborn": "fresh"}], "roots": ["{root}/fresh"], "expect": {"heads": {"{root}/fresh": "unborn"}}},
  {"name": "record-two-roots", "kind": "record", "setup": [{"repo": "repo", "branch": "main"}, {"repo": "other", "branch": "main"}], "roots": ["{root}/repo", "{root}/other"], "expect": {"heads": {"{root}/repo": "{rev:repo:HEAD}", "{root}/other": "{rev:other:HEAD}"}}},
  {"name": "record-repo-with-two-commits", "kind": "record", "setup": [{"repo": "repo", "branch": "main"}, {"file": "repo/a.txt", "text": "x\n"}, {"commit": "repo", "message": "add"}], "roots": ["{root}/repo"], "expect": {"heads": {"{root}/repo": "{rev:repo:HEAD}"}}},
  {"name": "record-no-roots", "kind": "record", "setup": [{"repo": "repo", "branch": "main"}], "roots": [], "expect": {"heads": {}}},
  {"name": "moved-after-commit", "kind": "moved", "setup": [{"repo": "repo", "branch": "main"}], "roots": ["{root}/repo"], "commits": [{"file": "repo/a.txt", "text": "x\n"}, {"commit": "repo", "message": "add"}], "expect": [["{root}/repo", "{rev:repo:HEAD~1}", "{rev:repo:HEAD}"]]},
  {"name": "moved-is-empty-without-new-commit", "kind": "moved", "setup": [{"repo": "repo", "branch": "main"}], "roots": ["{root}/repo"], "commits": [], "expect": []},
  {"name": "moved-consumes-the-marker", "kind": "moved", "setup": [{"repo": "repo", "branch": "main"}], "roots": ["{root}/repo"], "commits": [{"file": "repo/a.txt", "text": "x\n"}, {"commit": "repo", "message": "add"}], "expect": [["{root}/repo", "{rev:repo:HEAD~1}", "{rev:repo:HEAD}"]], "expect_second": []},
  {"name": "moved-with-two-commits-gives-the-first-base", "kind": "moved", "setup": [{"repo": "repo", "branch": "main"}], "roots": ["{root}/repo"], "commits": [{"file": "repo/a.txt", "text": "x\n"}, {"commit": "repo", "message": "add"}, {"file": "repo/b.txt", "text": "x\n"}, {"commit": "repo", "message": "add"}], "expect": [["{root}/repo", "{rev:repo:HEAD~2}", "{rev:repo:HEAD}"]]},
  {"name": "moved-unborn-base-is-the-empty-tree", "kind": "moved", "setup": [{"unborn": "fresh"}], "roots": ["{root}/fresh"], "commits": [{"file": "fresh/a.txt", "text": "x\n"}, {"commit": "fresh", "message": "add"}], "expect": [["{root}/fresh", "{empty_tree}", "{rev:fresh:HEAD}"]]},
  {"name": "moved-unborn-without-commit-is-empty", "kind": "moved", "setup": [{"unborn": "fresh"}], "roots": ["{root}/fresh"], "commits": [], "expect": []},
  {"name": "moved-only-the-root-that-moved", "kind": "moved", "setup": [{"repo": "repo", "branch": "main"}, {"repo": "other", "branch": "main"}], "roots": ["{root}/repo", "{root}/other"], "commits": [{"file": "other/a.txt", "text": "x\n"}, {"commit": "other", "message": "add"}], "expect": [["{root}/other", "{rev:other:HEAD~1}", "{rev:other:HEAD}"]]},
  {"name": "moved-keeps-the-order-of-the-roots", "kind": "moved", "setup": [{"repo": "repo", "branch": "main"}, {"repo": "other", "branch": "main"}], "roots": ["{root}/other", "{root}/repo"], "commits": [{"file": "repo/a.txt", "text": "x\n"}, {"commit": "repo", "message": "add"}, {"file": "other/a.txt", "text": "x\n"}, {"commit": "other", "message": "add"}], "expect": [["{root}/other", "{rev:other:HEAD~1}", "{rev:other:HEAD}"], ["{root}/repo", "{rev:repo:HEAD~1}", "{rev:repo:HEAD}"]]},
  {"name": "moved-without-roots-is-empty", "kind": "moved", "setup": [{"repo": "repo", "branch": "main"}], "roots": [], "commits": [{"file": "repo/a.txt", "text": "x\n"}, {"commit": "repo", "message": "add"}], "expect": []},
  {"name": "changed-files-rename-gives-both-sides", "kind": "changed_files", "setup": [{"repo": "repo", "branch": "main"}, {"file": "repo/a.txt", "text": "x\n"}, {"commit": "repo", "message": "add"}, {"file": "repo/c.txt", "text": "x\n"}, {"mv": "repo", "from": "a.txt", "to": "b.txt"}, {"commit": "repo", "message": "rename"}], "repo": "{root}/repo", "base": "{rev:repo:HEAD~1}", "head": "{rev:repo:HEAD}", "expect": ["a.txt", "b.txt", "c.txt"]},
  {"name": "changed-files-rename-alone", "kind": "changed_files", "setup": [{"repo": "repo", "branch": "main"}, {"file": "repo/a.txt", "text": "x\n"}, {"commit": "repo", "message": "add"}, {"mv": "repo", "from": "a.txt", "to": "b.txt"}, {"commit": "repo", "message": "rename"}], "repo": "{root}/repo", "base": "{rev:repo:HEAD~1}", "head": "{rev:repo:HEAD}", "expect": ["a.txt", "b.txt"]},
  {"name": "changed-files-path-with-space", "kind": "changed_files", "setup": [{"repo": "repo", "branch": "main"}, {"file": "repo/dir/x y.py", "text": "x\n"}, {"commit": "repo", "message": "add"}], "repo": "{root}/repo", "base": "{rev:repo:HEAD~1}", "head": "{rev:repo:HEAD}", "expect": ["dir/x y.py"]},
  {"name": "changed-files-are-sorted", "kind": "changed_files", "setup": [{"repo": "repo", "branch": "main"}, {"file": "repo/b.txt", "text": "x\n"}, {"file": "repo/a.txt", "text": "x\n"}, {"commit": "repo", "message": "add"}], "repo": "{root}/repo", "base": "{rev:repo:HEAD~1}", "head": "{rev:repo:HEAD}", "expect": ["a.txt", "b.txt"]},
  {"name": "changed-files-non-ascii-path", "kind": "changed_files", "setup": [{"repo": "repo", "branch": "main"}, {"file": "repo/caf\u00e9.txt", "text": "x\n"}, {"commit": "repo", "message": "add"}], "repo": "{root}/repo", "base": "{rev:repo:HEAD~1}", "head": "{rev:repo:HEAD}", "expect": ["caf\u00e9.txt"]},
  {"name": "changed-files-from-the-empty-tree", "kind": "changed_files", "setup": [{"repo": "repo", "branch": "main"}], "repo": "{root}/repo", "base": "{empty_tree}", "head": "{rev:repo:HEAD}", "expect": ["README.md"]},
  {"name": "changed-files-same-commit-is-empty", "kind": "changed_files", "setup": [{"repo": "repo", "branch": "main"}], "repo": "{root}/repo", "base": "{rev:repo:HEAD}", "head": "{rev:repo:HEAD}", "expect": []}
]
