 {
  "name": "test_parse_worktrees_python_line_and_digit_rules",
  "fn": "parse_worktrees",
  "input": {
   "porcelain": "worktree /r\r\nbranch refs/heads/a\r\nlocked x (pid ١٢)\n\nworktree /r/w x\nbranch refs/heads/\nworktree /r/v\nlocked (pid 12abc) (pid 7)\n"
  },
  "expect": [
   {
    "path": "/r",
    "branch": "a",
    "locked": true,
    "lock_pid": 12,
    "lock_reason": "x (pid ١٢)"
   },
   {
    "path": "/r/w",
    "branch": "",
    "locked": false,
    "lock_pid": null,
    "lock_reason": null
   },
   {
    "path": "/r/v",
    "branch": null,
    "locked": true,
    "lock_pid": 12,
    "lock_reason": "(pid 12abc) (pid 7)"
   }
  ]
 },
