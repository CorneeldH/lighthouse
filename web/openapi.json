{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "HealthOutputBody": {
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "type": "object"
      },
      "Question": {
        "additionalProperties": false,
        "properties": {
          "answer_url": {
            "type": "string"
          },
          "number": {
            "format": "int64",
            "type": "integer"
          },
          "question": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "number",
          "title",
          "url",
          "question",
          "answer_url"
        ],
        "type": "object"
      },
      "QuestionsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "questions"
        ],
        "type": "object"
      },
      "Report": {
        "additionalProperties": false,
        "properties": {
          "claude": {
            "$ref": "#/components/schemas/SourceReport"
          },
          "codex": {
            "$ref": "#/components/schemas/SourceReport"
          }
        },
        "required": [
          "claude",
          "codex"
        ],
        "type": "object"
      },
      "Returned": {
        "additionalProperties": false,
        "properties": {
          "number": {
            "format": "int64",
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "number",
          "title",
          "url",
          "reason"
        ],
        "type": "object"
      },
      "ReturnedOutputBody": {
        "additionalProperties": false,
        "properties": {
          "returned": {
            "items": {
              "$ref": "#/components/schemas/Returned"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "returned"
        ],
        "type": "object"
      },
      "SourceReport": {
        "additionalProperties": false,
        "properties": {
          "session": {
            "$ref": "#/components/schemas/WindowReport"
          },
          "week": {
            "$ref": "#/components/schemas/WindowReport"
          }
        },
        "required": [
          "session",
          "week"
        ],
        "type": "object"
      },
      "WindowReport": {
        "additionalProperties": false,
        "properties": {
          "age_s": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "lower_bound": {
            "type": "boolean"
          },
          "pct": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "reset_at": {
            "type": "string"
          },
          "state": {
            "enum": [
              "ok",
              "stale",
              "not_measurable"
            ],
            "type": "string"
          }
        },
        "required": [
          "state",
          "pct",
          "reset_at",
          "age_s",
          "lower_bound"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "lighthouse",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "get-health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get API health"
      }
    },
    "/api/questions": {
      "get": {
        "operationId": "get-questions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get API questions"
      }
    },
    "/api/returned": {
      "get": {
        "operationId": "get-returned",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReturnedOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get API returned"
      }
    },
    "/api/usage": {
      "get": {
        "operationId": "get-usage",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get API usage"
      }
    }
  }
}
