    "skills": [
      "go-writing"
    ],
    "agents": [],
    "workflows": [],
    "hooks": [
      {
        "name": "gofmt",
        "events": [
          "PostToolUse"
        ],
        "when": "after every edit"
      },
      {
        "name": "go-check",
        "events": [
          "Stop"
        ],
        "when": "when the session stops"
      }
    ],
    "extra": []
  },
  {
