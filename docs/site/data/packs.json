[
  {
    "name": "core",
    "proposed_when": "always",
    "detect": [],
    "skills": [
      "close-issue",
      "fix-pr",
      "handoff",
      "instrument",
      "plan-adversarial-review",
      "route-issue",
      "spec-adversarial-review",
      "start-issue",
      "testing",
      "verify-pr",
      "worktree-audit",
      "write-issue"
    ],
    "agents": [
      "issue-impact-scout"
    ],
    "workflows": [
      "unblock-dependents"
    ],
    "hooks": [
      {
        "name": "main-commit-guard",
        "events": [
          "PreToolUse"
        ],
        "when": "before every shell command"
      },
      {
        "name": "commit-tests",
        "events": [
          "PreToolUse",
          "PostToolUse",
          "PostToolUseFailure"
        ],
        "when": "around every shell command"
      },
      {
        "name": "bash-write-gates",
        "events": [
          "PreToolUse",
          "PostToolUse",
          "PostToolUseFailure"
        ],
        "when": "around every shell command"
      },
      {
        "name": "pr-create-gate",
        "events": [
          "PreToolUse"
        ],
        "when": "before every shell command"
      },
      {
        "name": "worktree-guard",
        "events": [
          "PreToolUse"
        ],
        "when": "before every edit"
      },
      {
        "name": "worktree-linkcheck",
        "events": [
          "PostToolUse"
        ],
        "when": "after every edit"
      },
      {
        "name": "code-language",
        "events": [
          "PostToolUse"
        ],
        "when": "after every edit"
      },
      {
        "name": "usage-guard",
        "events": [
          "PostToolUse",
          "Stop",
          "SubagentStop",
          "UserPromptSubmit"
        ],
        "when": "at every prompt, tool call, subagent stop and session stop"
      }
    ],
    "extra": [
      "the pull request template"
    ]
  },
  {
