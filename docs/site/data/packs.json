[
  {
    "name": "core",
    "proposed_when": "always",
    "detect": [],
    "skills": [
      "audit-worktrees",
      "close-issue",
      "fix-pr",
      "place-instruction",
      "review-plan",
      "review-spec",
      "route-issue",
      "start-issue",
      "test-standard",
      "write-handoff",
      "write-issue",
      "write-pr"
    ],
    "standard_skills": [
      "test-standard"
    ],
    "agents": [
      "issue-impact-scout"
    ],
    "workflows": [
      "unblock-dependents"
    ],
    "hooks": [
      {
        "name": "main-commit-gate",
        "source": "internal/hooks/maincommitgate.go",
        "events": [
          "PreToolUse"
        ],
        "when": "before every shell command"
      },
      {
        "name": "commit-test-gate",
        "events": [
          "PreToolUse",
          "PostToolUse",
          "PostToolUseFailure"
        ],
        "when": "around every shell command"
      },
      {
        "name": "bash-write-check",
        "source": "internal/hooks/bashwritecheck.go",
        "events": [
          "PreToolUse",
          "PostToolUse",
          "PostToolUseFailure"
        ],
        "when": "around every shell command"
      },
      {
        "name": "pr-create-gate",
        "events": [
          "PreToolUse"
        ],
        "when": "before every shell command"
      },
      {
        "name": "worktree-check",
        "source": "internal/hooks/worktreecheck.go",
        "events": [
          "PreToolUse"
        ],
        "when": "before every edit"
      },
      {
        "name": "md-link-check",
        "source": "internal/hooks/mdlinkcheck.go",
        "events": [
          "PostToolUse"
        ],
        "when": "after every edit"
      },
      {
        "name": "code-language-check",
        "events": [
          "PostToolUse"
        ],
        "when": "after every edit"
      },
      {
        "name": "usage-gate",
        "source": "internal/hooks/usagegate.go",
        "events": [
          "PostToolUse",
          "Stop",
          "SubagentStop",
          "UserPromptSubmit"
        ],
        "when": "at every prompt, tool call, subagent stop and session stop"
      },
      {
        "name": "permission-check",
        "source": "internal/hooks/permissioncheck.go",
        "events": [
          "Notification"
        ],
        "when": "when Claude asks for a permission in a controller run"
      }
    ],
    "extra": [
      "the pull request template"
    ]
  },
  {
    "name": "go",
    "proposed_when": "a go.mod in the repository root",
    "detect": [
      "go.mod"
    ],
    "skills": [
      "go-standard"
    ],
    "standard_skills": [
      "go-standard"
    ],
    "agents": [],
    "workflows": [],
    "hooks": [
      {
        "name": "gofmt-check",
        "events": [
          "PostToolUse"
        ],
        "when": "after every edit"
      },
      {
        "name": "go-lint-gate",
        "events": [
          "Stop"
        ],
        "when": "when the session stops"
      }
    ],
    "extra": []
  },
  {
    "name": "node",
    "proposed_when": "a package.json that git tracks",
    "detect": [
      "**/package.json"
    ],
    "skills": [],
    "standard_skills": [],
    "agents": [],
    "workflows": [],
    "hooks": [],
    "extra": []
  },
  {
    "name": "python",
    "proposed_when": "a pyproject.toml in the repository root",
    "detect": [
      "pyproject.toml"
    ],
    "skills": [
      "python-standard"
    ],
    "standard_skills": [
      "python-standard"
    ],
    "agents": [],
    "workflows": [],
    "hooks": [
      {
        "name": "ruff-format-check",
        "events": [
          "PostToolUse"
        ],
        "when": "after every edit"
      },
      {
        "name": "ty-gate",
        "events": [
          "Stop"
        ],
        "when": "when the session stops"
      }
    ],
    "extra": [
      "sets the test gate (uv run pytest -q)"
    ]
  },
  {
    "name": "shell",
    "proposed_when": "git tracks a .sh or .bash file",
    "detect": [
      "**/*.sh",
      "**/*.bash"
    ],
    "skills": [
      "shell-standard"
    ],
    "standard_skills": [
      "shell-standard"
    ],
    "agents": [],
    "workflows": [],
    "hooks": [
      {
        "name": "shell-lint-check",
        "events": [
          "PostToolUse"
        ],
        "when": "after every edit"
      }
    ],
    "extra": []
  },
  {
    "name": "expo",
    "proposed_when": "a package.json that names expo",
    "detect": [
      "**/package.json"
    ],
    "skills": [
      "refresh-expo-lockfiles"
    ],
    "standard_skills": [],
    "agents": [],
    "workflows": [],
    "hooks": [],
    "extra": []
  }
]
