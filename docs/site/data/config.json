{
  "title": "The configuration",
  "subtitle": "Every key of lighthouse.toml and host.toml: whether you set it, its default, and what reads it.",
  "files": [
    {
      "file": "lighthouse.toml",
      "path": "<repo>/lighthouse.toml",
      "override": "LIGHTHOUSE_TOML",
      "written": "lighthouse init writes [project] language and [forge], plus the keys of the packages it installs. You add the rest by hand. Commit it: it holds the settings of the project.",
      "tables": [
        {
          "table": "project",
          "title": "Project",
          "about": "The languages the project writes in. language sets the language of issues, PRs and commit messages; most projects set only that. The other keys guard the language of the code and the size of the instruction files.",
          "keys": [
            {
              "key": "project.language",
              "level": "set",
              "required": "no",
              "default": "en",
              "about": "The language of issues, PRs and commit messages: nl or en.",
              "options": [
                "nl",
                "en"
              ],
              "readers": [
                "internal/config/headings.go",
                "internal/dispatch/instructions/run.md",
                "internal/repoconfig/repoconfig.go",
                "internal/triage/judgment.go",
                "pack/core/instructions/AGENTS.md",
                "pack/core/lib/artefacts.py",
                "pack/core/lib/evidence.py",
                "pack/core/lib/headings.py",
                "pack/core/lib/protocol.py",
                "pack/core/scripts/plan_review_record.py",
                "pack/core/skills/close-issue",
                "pack/core/skills/write-handoff",
                "pack/core/skills/write-issue",
                "pack/core/skills/write-pr",
                "pack/python/scripts/quality/prcov_issues.py"
              ]
            },
            {
              "key": "project.code_language",
              "level": "advanced",
              "required": "no",
              "about": "The language names, comments and docstrings in code must be written in.",
              "options": [
                "en"
              ],
              "example": "en",
              "readers": [
                "pack/core/hooks/code-language-check.sh",
                "pack/core/instructions/AGENTS.md",
                "pack/core/lib/code_language.py"
              ]
            },
            {
              "key": "project.code_language_exempt",
              "level": "advanced",
              "required": "no",
              "about": "Paths exempt from the code-language check.",
              "example": [
                "tests/fixtures/**"
              ],
              "readers": [
                "pack/core/lib/code_language.py"
              ]
            },
            {
              "key": "project.code_language_paths",
              "level": "advanced",
              "required": "no",
              "about": "Extra paths that must follow the code language, such as documentation.",
              "example": [
                "docs/**"
              ],
              "readers": [
                "pack/core/hooks/code-language-check.sh",
                "pack/core/lib/code_language.py"
              ]
            },
            {
              "key": "project.instructions_word_ceiling",
              "level": "advanced",
              "required": "no",
              "default": 3000,
              "about": "The word budget for the instruction files; the check fails above it.",
              "readers": [
                "internal/initcmd/budget.go",
                "pack/core/scripts/check-instructions.sh",
                "pack/core/skills/place-instruction"
              ]
            },
            {
              "key": "project.milestone_prefix",
              "level": "advanced",
              "required": "no",
              "about": "The prefix of milestone titles in this project.",
              "example": "LH",
              "readers": [
                "pack/core/skills/close-issue",
                "pack/core/skills/write-issue"
              ]
            },
            {
              "key": "project.skill_prefix",
              "level": "advanced",
              "required": "no",
              "about": "The prefix of your own skill names, used when placing a new instruction.",
              "example": "myproject-",
              "readers": [
                "pack/core/skills/place-instruction"
              ]
            }
          ]
        },
        {
          "table": "forge",
          "title": "Forge",
          "about": "Where the repository lives. Skills and hooks read owner/name to talk to GitHub, and default_branch is the branch the commit gate guards.",
          "keys": [
            {
              "key": "forge.kind",
              "level": "set",
              "required": "no",
              "about": "Which forge hosts the repo. Only github is accepted for now.",
              "options": [
                "github"
              ],
              "example": "github",
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "internal/workplace/kennforge/adapter.go"
              ]
            },
            {
              "key": "forge.repo",
              "level": "set",
              "required": "no",
              "about": "The repository as owner/name.",
              "example": "owner/name",
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "pack/core/lib/artefacts.py",
                "pack/core/lib/pr_body_gate.py",
                "pack/core/scripts/board_start.py",
                "pack/core/scripts/post_artefact.py",
                "pack/core/scripts/worktree_audit.py",
                "pack/core/skills/audit-worktrees",
                "pack/core/skills/close-issue",
                "pack/core/skills/fix-pr",
                "pack/core/skills/review-plan",
                "pack/core/skills/route-issue",
                "pack/core/skills/start-issue",
                "pack/core/skills/write-handoff",
                "pack/core/skills/write-issue",
                "pack/core/skills/write-pr",
                "pack/python/scripts/quality/prcov_issues.py"
              ]
            },
            {
              "key": "forge.default_branch",
              "level": "advanced",
              "required": "no",
              "default": "main",
              "about": "The branch that work is merged into and that commits are guarded on.",
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "pack/core/hooks/commit-test-gate.sh",
                "pack/core/hooks/main-commit-gate.sh",
                "pack/core/hooks/worktree-check.sh",
                "pack/core/lib/protocol.py",
                "pack/core/scripts/post_artefact.py",
                "pack/core/scripts/roborev_gate.py",
                "pack/core/scripts/worktree_audit.py",
                "pack/core/skills/audit-worktrees",
                "pack/core/skills/close-issue",
                "pack/core/skills/start-issue",
                "pack/core/skills/write-handoff",
                "pack/core/skills/write-issue",
                "pack/core/workflows/unblock-dependents.yml",
                "pack/python/scripts/quality/prcov_issues.py",
                "pack/python/scripts/quality/ratchet.py",
                "pack/python/skills/python-standard"
              ]
            },
            {
              "key": "forge.name",
              "level": "advanced",
              "required": "derived",
              "about": "The name part of forge.repo, derived by config.py.",
              "readers": [
                "pack/core/scripts/board_start.py",
                "pack/core/skills/close-issue",
                "pack/core/skills/write-handoff",
                "pack/python/scripts/quality/prcov_issues.py"
              ]
            },
            {
              "key": "forge.owner",
              "level": "advanced",
              "required": "derived",
              "about": "The owner part of forge.repo, derived by config.py.",
              "readers": [
                "pack/core/scripts/board_start.py",
                "pack/core/skills/close-issue",
                "pack/core/skills/write-handoff",
                "pack/core/skills/write-issue",
                "pack/python/scripts/quality/prcov_issues.py"
              ]
            }
          ]
        },
        {
          "table": "forge.board",
          "title": "Project board",
          "about": "A GitHub project board that issues move on when work starts. Leave the table out and nothing touches a board. With the table, the keys marked required must be there.",
          "keys": [
            {
              "key": "forge.board.priority_field_id",
              "level": "optional",
              "required": "no",
              "about": "The id of the board's Priority field.",
              "example": "PVTSSF_...",
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "pack/core/skills/write-issue"
              ]
            },
            {
              "key": "forge.board.priority_options",
              "level": "optional",
              "required": "no",
              "about": "The ids of the Priority options, one entry per option name.",
              "example": {
                "P0": "...",
                "P1": "...",
                "P2": "..."
              },
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "pack/core/skills/write-issue"
              ]
            },
            {
              "key": "forge.board.project_id",
              "level": "optional",
              "required": "with [forge.board]",
              "about": "The node id of the GitHub project board.",
              "example": "PVT_...",
              "readers": [
                "internal/cli/triage.go",
                "internal/repoconfig/repoconfig.go",
                "pack/core/scripts/board_start.py",
                "pack/core/skills/close-issue",
                "pack/core/skills/write-handoff",
                "pack/core/skills/write-issue",
                "pack/python/scripts/quality/prcov_issues.py"
              ]
            },
            {
              "key": "forge.board.project_number",
              "level": "optional",
              "required": "with [forge.board]",
              "about": "The number of the GitHub project board.",
              "example": 1,
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "pack/core/skills/start-issue",
                "pack/core/skills/write-handoff",
                "pack/core/skills/write-issue",
                "pack/python/scripts/quality/prcov_issues.py"
              ]
            },
            {
              "key": "forge.board.status_field_id",
              "level": "optional",
              "required": "with [forge.board]",
              "about": "The id of the board's Status field.",
              "example": "PVTSSF_...",
              "readers": [
                "internal/cli/triage.go",
                "internal/repoconfig/repoconfig.go",
                "pack/core/scripts/board_start.py",
                "pack/core/skills/close-issue",
                "pack/core/skills/write-handoff",
                "pack/python/scripts/quality/prcov_issues.py"
              ]
            },
            {
              "key": "forge.board.status_options",
              "level": "optional",
              "required": "with [forge.board]",
              "about": "The ids of the Status options, one entry per option name.",
              "example": {
                "To do": "...",
                "In progress": "...",
                "Done": "...",
                "On hold": "..."
              },
              "readers": [
                "internal/cli/serve.go",
                "internal/cli/triage.go",
                "internal/dispatch/board.go",
                "internal/repoconfig/repoconfig.go",
                "pack/core/scripts/board_start.py",
                "pack/core/skills/write-handoff",
                "pack/core/skills/write-issue",
                "pack/python/scripts/quality/prcov_issues.py"
              ]
            }
          ]
        },
        {
          "table": "test_gate",
          "title": "Test gate",
          "about": "The command commit-test-gate runs after each commit, on the files of that commit, and how long and how many at a time. Without a command the gate is off.",
          "keys": [
            {
              "key": "test_gate.command",
              "level": "set",
              "required": "no",
              "about": "The command the test gate runs after a commit; empty turns the gate off.",
              "example": "uv run pytest -q",
              "readers": [
                "pack/core/hooks/commit-test-gate.sh",
                "pack/core/instructions/AGENTS.md",
                "pack/core/skills/fix-pr",
                "pack/core/skills/write-pr",
                "pack/go/skills/go-standard",
                "pack/python/skills/python-standard"
              ]
            },
            {
              "key": "test_gate.deadline_seconds",
              "level": "advanced",
              "required": "no",
              "default": 270,
              "about": "How long the test gate may run before it gives up.",
              "readers": [
                "pack/core/hooks/commit-test-gate.sh"
              ]
            },
            {
              "key": "test_gate.evidence_test_dir",
              "level": "advanced",
              "required": "no",
              "default": "tests/",
              "about": "The directory where tests live, searched for evidence in a PR body.",
              "readers": [
                "pack/core/lib/evidence.py",
                "pack/core/skills/write-pr"
              ]
            },
            {
              "key": "test_gate.slot_wait_seconds",
              "level": "advanced",
              "required": "no",
              "default": 180,
              "about": "How long a test gate waits for a free slot.",
              "readers": [
                "pack/core/hooks/commit-test-gate.sh"
              ]
            },
            {
              "key": "test_gate.slots",
              "level": "advanced",
              "required": "no",
              "default": 2,
              "about": "How many test gates may run at the same time on this machine.",
              "readers": [
                "pack/core/hooks/commit-test-gate.sh"
              ]
            },
            {
              "key": "test_gate.unchecked_exit_codes",
              "level": "advanced",
              "required": "no",
              "default": [],
              "about": "Exit codes of the test command that mean the tests could not run; the gate reports COULD NOT CHECK instead of failed tests.",
              "readers": [
                "pack/core/hooks/commit-test-gate.sh",
                "pack/go/scripts/gate_go.py",
                "pack/go/skills/go-standard",
                "pack/node/scripts/gate_node.py",
                "pack/python/scripts/gate_python.py",
                "pack/python/skills/python-standard"
              ]
            }
          ]
        },
        {
          "table": "paths",
          "title": "Paths",
          "about": "Where specs and plans are written, and where the project keeps the documents that skills read, such as its tenets and its labels.",
          "keys": [
            {
              "key": "paths.areas",
              "level": "advanced",
              "required": "no",
              "about": "The folder with one file per area; closing a milestone updates its near goal.",
              "example": "docs/areas",
              "readers": [
                "pack/core/skills/close-issue"
              ]
            },
            {
              "key": "paths.history",
              "level": "advanced",
              "required": "no",
              "about": "The file with the project's history; only config.py checks it for now.",
              "example": "docs/history.md",
              "readers": []
            },
            {
              "key": "paths.labels",
              "level": "advanced",
              "required": "no",
              "about": "The file that lists the labels of the project, and the document a free label's PR updates.",
              "example": "docs/labels.md",
              "readers": [
                "pack/core/skills/write-issue",
                "pack/core/skills/write-pr"
              ]
            },
            {
              "key": "paths.mirror_exceptions",
              "level": "advanced",
              "required": "no",
              "about": "The file that lists instruction files exempt from the mirror check.",
              "example": "docs/mirror-exceptions.md",
              "readers": [
                "pack/core/scripts/check-instructions.sh"
              ]
            },
            {
              "key": "paths.plans",
              "level": "advanced",
              "required": "no",
              "default": "docs/developer/planning/plans",
              "about": "Where plans are written.",
              "readers": [
                "pack/core/scripts/measure_start_issue_kpi.py",
                "pack/core/scripts/plan_review_record.py",
                "pack/core/scripts/post_artefact.py",
                "pack/core/skills/review-plan",
                "pack/core/skills/start-issue",
                "pack/core/skills/write-handoff",
                "pack/core/skills/write-pr"
              ]
            },
            {
              "key": "paths.search_dirs",
              "level": "advanced",
              "required": "no",
              "default": [
                "."
              ],
              "about": "The directories searched when starting an issue.",
              "readers": [
                "pack/core/skills/start-issue"
              ]
            },
            {
              "key": "paths.specs",
              "level": "advanced",
              "required": "no",
              "default": "docs/developer/planning/specs",
              "about": "Where specs are written.",
              "readers": [
                "pack/core/scripts/measure_start_issue_kpi.py",
                "pack/core/scripts/plan_review_record.py",
                "pack/core/scripts/post_artefact.py",
                "pack/core/skills/review-spec",
                "pack/core/skills/start-issue",
                "pack/core/skills/write-handoff",
                "pack/core/skills/write-pr"
              ]
            },
            {
              "key": "paths.tenets",
              "level": "advanced",
              "required": "no",
              "about": "The file with the project's tenets, read when writing an issue.",
              "example": "docs/tenets.md",
              "readers": [
                "pack/core/skills/write-issue"
              ]
            }
          ]
        },
        {
          "table": "labels",
          "title": "Labels",
          "about": "The names of the labels that mark a blocked or waiting issue. Change them only when the repository already uses other names.",
          "keys": [
            {
              "key": "labels.area_prefix",
              "level": "advanced",
              "required": "no",
              "about": "The prefix of area labels.",
              "example": "area:",
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "internal/triage/prompt.go",
                "pack/core/skills/start-issue",
                "pack/core/skills/write-issue",
                "pack/expo/skills/refresh-expo-lockfiles"
              ]
            },
            {
              "key": "labels.blocked_external",
              "level": "advanced",
              "required": "no",
              "default": "blocked-external",
              "about": "The label for an issue blocked by something outside the repo.",
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "internal/triage/rules.go",
                "pack/core/skills/route-issue",
                "pack/core/skills/write-issue"
              ]
            },
            {
              "key": "labels.blocked_issue",
              "level": "advanced",
              "required": "no",
              "default": "blocked-issue",
              "about": "The label for an issue blocked by another issue.",
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "internal/triage/rules.go",
                "pack/core/scripts/unblock_dependents.py",
                "pack/core/skills/close-issue",
                "pack/core/skills/route-issue",
                "pack/core/skills/start-issue",
                "pack/core/skills/write-issue",
                "pack/core/workflows/unblock-dependents.yml"
              ]
            },
            {
              "key": "labels.location_prefix",
              "level": "advanced",
              "required": "no",
              "about": "The prefix of location labels.",
              "example": "location:",
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "internal/triage/prompt.go",
                "pack/core/skills/start-issue",
                "pack/core/skills/write-issue"
              ]
            },
            {
              "key": "labels.needs_decision",
              "level": "advanced",
              "required": "no",
              "default": "needs-decision",
              "about": "The label for an issue that waits for a decision.",
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "pack/core/skills/route-issue",
                "pack/core/skills/write-issue"
              ]
            },
            {
              "key": "labels.needs_hands",
              "level": "advanced",
              "required": "no",
              "default": "needs-hands",
              "about": "The label for an issue that needs manual work.",
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "pack/core/skills/route-issue",
                "pack/core/skills/write-issue"
              ]
            },
            {
              "key": "labels.needs_shaping",
              "level": "advanced",
              "required": "no",
              "default": "needs-shaping",
              "about": "The label for an issue that still needs shaping.",
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "pack/core/skills/route-issue",
                "pack/core/skills/write-issue"
              ]
            },
            {
              "key": "labels.needs_testing",
              "level": "advanced",
              "required": "no",
              "default": "needs-testing",
              "about": "The label for an issue that needs testing by a person.",
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "pack/core/skills/route-issue",
                "pack/core/skills/write-issue"
              ]
            }
          ]
        },
        {
          "table": "ci",
          "title": "CI",
          "about": "The runner of the workflows lighthouse generates, and the bot the unblock lane runs as.",
          "keys": [
            {
              "key": "ci.bot_client_id_var",
              "level": "advanced",
              "required": "no",
              "about": "The name of the variable that holds the bot's client id.",
              "example": "BOT_CLIENT_ID",
              "readers": [
                "pack/core/workflows/unblock-dependents.yml"
              ]
            },
            {
              "key": "ci.bot_login",
              "level": "advanced",
              "required": "no",
              "about": "The login of the bot the unblock lane runs as, to unblock dependent issues.",
              "example": "my-bot[bot]",
              "readers": [
                "pack/core/skills/close-issue"
              ]
            },
            {
              "key": "ci.bot_private_key_secret",
              "level": "advanced",
              "required": "no",
              "about": "The name of the secret that holds the bot's private key.",
              "example": "BOT_PRIVATE_KEY",
              "readers": [
                "pack/core/workflows/unblock-dependents.yml"
              ]
            },
            {
              "key": "ci.runs_on",
              "level": "advanced",
              "required": "no",
              "default": "ubuntu-latest",
              "about": "The runner label the generated workflows use.",
              "readers": [
                "pack/core/workflows/unblock-dependents.yml"
              ]
            }
          ]
        },
        {
          "table": "usage_guard",
          "title": "Usage guard",
          "about": "What the usage gate does when the usage alarm goes up: whether a controller takes over the pause, and whether the session resumes after the window resets.",
          "keys": [
            {
              "key": "usage_guard.controller",
              "level": "advanced",
              "required": "no",
              "default": false,
              "about": "Whether the usage guard hands the pause to a controller; an advanced option.",
              "options": [
                true,
                false
              ],
              "readers": [
                "internal/repoconfig/repoconfig.go",
                "pack/core/hooks/usage-gate/controller.py",
                "pack/core/lib/usage_guard.py"
              ]
            },
            {
              "key": "usage_guard.resume",
              "level": "advanced",
              "required": "no",
              "default": false,
              "about": "Whether the usage guard writes a resume marker and schedules a one-shot wake-up after the window resets. Never on a week alarm.",
              "options": [
                true,
                false
              ],
              "readers": [
                "pack/core/hooks/usage-gate/resume.py",
                "pack/core/lib/usage_guard.py"
              ]
            }
          ]
        },
        {
          "table": "review",
          "title": "Review",
          "about": "Whether lighthouse-write-pr runs a local roborev review of the branch before it opens the PR; agent and model come from .roborev.toml.",
          "keys": [
            {
              "key": "review.roborev",
              "level": "set",
              "required": "no",
              "default": "off",
              "about": "Runs a local roborev review in lighthouse-write-pr before gh pr create: local or off.",
              "example": "local",
              "options": [
                "local",
                "off"
              ],
              "readers": [
                "pack/core/scripts/roborev_gate.py",
                "pack/core/skills/write-pr"
              ]
            }
          ]
        },
        {
          "table": "codex_usage",
          "title": "Codex usage",
          "about": "The Codex usage at which a spec or plan review runs without Codex, and how long to wait for the Codex app server.",
          "keys": [
            {
              "key": "codex_usage.app_server_timeout_seconds",
              "level": "advanced",
              "required": "no",
              "default": 20,
              "about": "How long to wait for the Codex app server.",
              "readers": [
                "pack/core/scripts/codex_usage.py"
              ]
            },
            {
              "key": "codex_usage.halt_pct_session",
              "level": "advanced",
              "required": "no",
              "default": 85,
              "about": "A [codex_usage] threshold that nothing reads yet; only config.py checks its type.",
              "readers": []
            },
            {
              "key": "codex_usage.review_pct_session",
              "level": "advanced",
