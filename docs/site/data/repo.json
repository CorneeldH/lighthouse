{
  "title": "Your repo after init",
  "subtitle": "Everything lighthouse init puts in your repo, the files of yours it edits, and what an upgrade does with each.",
  "dirs": [
    {
      "id": "root",
      "label": "your repo/"
    },
    {
      "id": ".claude",
      "label": ".claude/",
      "yours": "your own skills, agents and settings"
    },
    {
      "id": ".agents",
      "label": ".agents/",
      "yours": "your own skills"
    },
    {
      "id": ".lighthouse",
      "label": ".lighthouse/"
    },
    {
      "id": ".github",
      "label": ".github/",
      "yours": "your own workflows"
    }
  ],
  "rows": [
    {
      "id": "agents-md",
      "place": "AGENTS.md",
      "label": "AGENTS.md",
      "dir": "root",
      "kind": "rules",
      "act": "edits",
      "href": "system.html#rules",
      "upgrade": "lighthouse's blocks replaced, your text stays",
      "force": true
    },
    {
      "id": "lighthouse-toml",
      "place": "lighthouse.toml",
      "label": "lighthouse.toml",
      "dir": "root",
      "kind": "config",
      "act": "edits",
      "href": "config.html",
      "upgrade": "missing keys added, your values stay (old gate commands rewritten)",
      "force": false
    },
    {
      "id": "claude-hooks",
      "place": ".claude/hooks/lighthouse/",
      "label": "hooks/lighthouse/",
      "dir": ".claude",
      "kind": "hook",
      "act": "adds",
      "href": "reference.html#hooks",
      "upgrade": "replaced, stale ones removed",
      "force": true
    },
    {
      "id": "claude-skills",
      "place": ".claude/skills/lighthouse-*/",
      "label": "skills/lighthouse-*/",
      "dir": ".claude",
      "kind": "standard-skill",
      "act": "adds",
      "href": "reference.html#skills",
      "upgrade": "replaced, stale ones removed",
      "force": true
    },
    {
      "id": "claude-agents",
      "place": ".claude/agents/lighthouse-*.md",
      "label": "agents/lighthouse-*.md",
      "dir": ".claude",
      "kind": "agent",
      "act": "adds",
      "href": "reference.html#agents",
      "upgrade": "replaced, stale ones removed",
      "force": true
    },
    {
      "id": "claude-settings",
      "place": ".claude/settings.json",
      "label": "settings.json",
      "dir": ".claude",
      "kind": "config",
      "act": "edits",
      "upgrade": "lighthouse's hooks and rules replaced, the rest stays",
      "force": true
    },
    {
      "id": "agents-skills",
      "place": ".agents/skills/lighthouse-*/",
      "label": "skills/lighthouse-*/",
      "dir": ".agents",
      "kind": "standard-skill",
      "act": "adds",
      "href": "reference.html#skills",
      "upgrade": "replaced, stale ones removed",
      "force": true
    },
    {
      "id": "lighthouse-scripts",
      "place": ".lighthouse/scripts/",
      "label": "scripts/",
      "dir": ".lighthouse",
      "kind": "config",
      "act": "adds",
      "upgrade": "replaced, stale ones removed",
      "force": true
    },
    {
      "id": "headings",
      "place": ".lighthouse/headings.toml",
      "label": "headings.toml",
      "dir": ".lighthouse",
      "kind": "config",
      "act": "adds",
      "upgrade": "replaced",
      "force": true
    },
    {
      "id": "manifest",
      "place": ".lighthouse/manifest.toml",
      "label": "manifest.toml",
      "dir": ".lighthouse",
      "kind": "config",
      "act": "adds",
      "upgrade": "rewritten on every run",
      "force": false
    },
    {
      "id": "pr-template",
      "place": ".github/pull_request_template.md",
      "label": "pull_request_template.md",
      "dir": ".github",
      "kind": "github",
      "act": "adds",
      "href": "reference.html#github",
      "upgrade": "replaced",
      "force": true
    },
    {
      "id": "workflows",
      "place": ".github/workflows/lighthouse-*.yml",
      "label": "workflows/lighthouse-*.yml",
      "dir": ".github",
      "kind": "github",
      "act": "adds",
      "href": "reference.html#github",
      "upgrade": "replaced, stale ones removed",
      "force": true
    },
    {
      "id": "host-toml",
      "label": "~/.config/lighthouse/host.toml",
      "dir": "workstation",
      "kind": "config",
      "act": "adds",
      "href": "config.html",
      "upgrade": "left alone",
      "force": false
    }
  ],
  "yours": "your code, your tests, your config, …",
  "workstation": {
    "label": "On your workstation",
    "note": "Only with Tailscale. It is not in the repo, so a teammate or another machine does not have it."
  },
  "upgradeNote": "One edited part stops the whole upgrade; --force overwrites every edited part at once."
}
